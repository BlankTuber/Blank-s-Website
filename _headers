# Applied by Cloudflare Pages to every response
# Only self-hosted files plus Google Fonts are allowed. Loosen the CSP if you add other embeds or scripts.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
